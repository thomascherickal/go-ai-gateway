{
  "name": "go-ai-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "go run github.com/syumai/workers-go/cmd/workers-assets-gen && tinygo build -o ./build/app.wasm -target wasm -no-debug ./...",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:pages": "wrangler pages dev --config wrangler.pages.jsonc",
    "deploy:pages": "wrangler pages deploy --config wrangler.pages.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply ai-gateway-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ai-gateway-db --remote"
  },
  "devDependencies": {
    "wrangler": "^4.9.1"
  }
}
