# =============================================================================
# Go AI Gateway — Deployment Environment Configuration
# Copy to .env and fill in the keys for the providers you want to enable:
#   cp .env.example .env && chmod 600 .env
# =============================================================================

# --- Cloudflare Authentication (optional if already logged in via `npx wrangler login`) ---
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# --- Cloudflare Resource Names ---
WORKER_NAME=go-ai-gateway
PAGES_PROJECT_NAME=go-ai-gateway-demo
D1_DATABASE_NAME=ai-gateway-db
AI_GATEWAY_ID=

# --- Gateway Security & Demo Seeding ---
# REQUIRED for /admin/* endpoints and dashboard login:
ADMIN_TOKEN=change_me_to_a_long_random_admin_secret
# Set true ONLY for non-production / demo environments to seed demo keys:
SEED_DEMO_TEAMS=false

# --- Personal / Single-User Mode (used for --target local or auto-provisioning) ---
PERSONAL_MODE=true
PERSONAL_API_KEY=gw_personal_secret_change_me
PERSONAL_MONTHLY_BUDGET_USD=30
PERSONAL_PII_MODE=redact
PERSONAL_MAX_TIER=reasoning
# Optional per-provider monthly USD caps across all requests:
PROVIDER_LIMITS_USD=anthropic=5,openai=5,gemini=3,grok=3,deepseek=2,qwen=2

# --- External AI Vendor API Keys (leave blank for any vendor you don't use) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# DASHSCOPE_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# --- Optional Custom OpenAI-Compatible or Local Ollama Upstream ---
# UPSTREAM_BASE_URL=
# UPSTREAM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Optional Cloudflare Workers AI REST credentials (for --target local only) ---
# CF_ACCOUNT_ID=
# CF_API_TOKEN=

